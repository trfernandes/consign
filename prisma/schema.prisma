// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GESTOR
  FUNCIONARIO
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcionarios Funcionario[]
  carteiras    CarteiraRevendedora[]
  produtos     Produto[]
  estoques     EstoqueCentral[]
}

model Funcionario {
  id         String   @id @default(uuid())
  authUserId String   @unique
  nome       String
  email      String   @unique
  telefone   String
  role       Role
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  carteiras    CarteiraRevendedora[]
  estoqueCarro EstoqueCarro[]
  retiradas    RetiradaEstoque[]
  vendas       Venda[]
  pagamentos   Pagamento[]
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

model Revendedora {
  id         String  @id @default(uuid())
  authUserId String? @unique

  nome            String
  cpf             String  @unique
  telefone        String
  pontoReferencia String?

  rua       String
  numero    String
  bairro    String
  cidade    String
  estado    String
  cep       String
  latitude  Float
  longitude Float

  carteiras CarteiraRevendedora[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarteiraRevendedora {
  id String @id @default(uuid())

  revendedoraId String
  revendedora   Revendedora @relation(fields: [revendedoraId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  funcionarioResponsavelId String
  funcionarioResponsavel   Funcionario @relation(fields: [funcionarioResponsavelId], references: [id])

  ativa Boolean @default(true)

  saldoDevedor Decimal @default(0) @db.Decimal(10, 2)

  disponibilidades DisponibilidadeRevendedora[]
  vendas           Venda[]
  pagamentos       Pagamento[]
  estoques         EstoqueRevendedora[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([revendedoraId, empresaId])
}

enum FormaPagamento {
  DINHEIRO
  PIX
  OUTRO
}

model Venda {
  id String @id @default(uuid())

  carteiraId String
  carteira   CarteiraRevendedora @relation(fields: [carteiraId], references: [id])

  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])

  valorTotal Decimal @db.Decimal(10, 2)

  itens ItemVenda[]

  createdAt DateTime @default(now())
}

model ItemVenda {
  id String @id @default(uuid())

  vendaId String
  venda   Venda @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
}

model Pagamento {
  id String @id @default(uuid())

  carteiraId String
  carteira   CarteiraRevendedora @relation(fields: [carteiraId], references: [id])

  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])

  valor Decimal        @db.Decimal(10, 2)
  forma FormaPagamento

  createdAt DateTime @default(now())
}

model EstoqueRevendedora {
  id String @id @default(uuid())

  carteiraId String
  carteira   CarteiraRevendedora @relation(fields: [carteiraId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  quantidade Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([carteiraId, produtoId])
}

model Produto {
  id    String @id @default(uuid())
  nome  String
  preco Decimal @db.Decimal(10, 2)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  estoqueCentral     EstoqueCentral?
  estoqueCarro       EstoqueCarro[]
  retiradas          RetiradaEstoque[]
  itensVenda         ItemVenda[]
  estoquesRevendedora EstoqueRevendedora[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstoqueCentral {
  id String @id @default(uuid())

  produtoId String  @unique
  produto   Produto @relation(fields: [produtoId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  quantidade Int @default(0)

  updatedAt DateTime @updatedAt
}

model EstoqueCarro {
  id String @id @default(uuid())

  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  quantidade Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([funcionarioId, produtoId])
}

model RetiradaEstoque {
  id String @id @default(uuid())

  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  quantidade Int

  createdAt DateTime @default(now())
}

model DisponibilidadeRevendedora {
  id String @id @default(uuid())

  carteiraId String
  carteira   CarteiraRevendedora @relation(fields: [carteiraId], references: [id], onDelete: Cascade)

  diaSemana  DiaSemana
  horaInicio String
  horaFim    String
}
